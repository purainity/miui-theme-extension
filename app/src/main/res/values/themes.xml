<resources>
    <style name="Theme.MiuiThemeExtension" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
    </style>

    <style name="SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="StatusCard" parent="SettingsCard">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

    <style name="SettingsSection" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>

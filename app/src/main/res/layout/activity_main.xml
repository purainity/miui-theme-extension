<?xml version="1.0" encoding="utf-8"?>
<!-- 模块配置界面：顶栏 + 激活状态卡 → 版本信息卡 → 总开关卡 → 五组功能开关（角标开关跟随对应解锁开关分组）→ 关于入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 激活状态卡片：状态图标 + 两行文字，容器颜色与文字颜色随激活状态切换 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/activationCard"
                style="@style/Widget.MiuiThemeExtension.StatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/activationIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@string/inactive"
                        android:src="@drawable/ic_status_inactive"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/activation"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/activationHint"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 版本信息卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/moduleVersionRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/deviceModelRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/androidVersionRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/miuiVersionRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/xposedApiRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/hostThemeRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/hostAssistantRow" layout="@layout/item_info_row" />
                    <include android:id="@+id/hostHomeRow" layout="@layout/item_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 总开关卡片：独立卡片，位于设置区最上方 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/masterCard"
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include android:id="@+id/masterRow" layout="@layout/item_setting_row" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组：主题资源（解锁 + 角标跟随同组） -->
            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_resources"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/thirdThemeRow" layout="@layout/item_setting_row" />
                    <include android:id="@+id/resourcesRow" layout="@layout/item_setting_row" />
                    <include android:id="@+id/paidBadgesRow" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组：大图标——独立解锁管线，无角标开关，feed 卡片价格由数据层 Hook 归零 -->
            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_large_icons"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/largeIconsRow" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组：小组件 -->
            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_widgets"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/widgetsRow" layout="@layout/item_setting_row" />
                    <include android:id="@+id/widgetBadgesRow" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组：广告 -->
            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_ads"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/adsRow" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组：其他设置 -->
            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_other"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/hideIconRow" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 关于入口：底部独立卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MiuiThemeExtension.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <include android:id="@+id/aboutRow" layout="@layout/item_navigation" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
